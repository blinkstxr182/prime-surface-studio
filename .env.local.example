# Email (Resend — get your key at resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Analytics 4 measurement ID (format: G-XXXXXXXXXX) — optional
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Tag Manager container ID (format: GTM-XXXXXXX) — optional
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Google Ads account ID (format: AW-XXXXXXXXXX)
# Default in code: AW-18103141318. Override here if needed.
NEXT_PUBLIC_GADS_ID=AW-18103141318

# Google Ads conversion send_to label — fires on quote + contact form submit
# Default in code: AW-18103141318/io6OCKT9qa0cEMaHoLhD (the "Contact" conversion action).
# Override here only if you create a new conversion action in Google Ads.
NEXT_PUBLIC_GADS_CONVERSION_LABEL=AW-18103141318/io6OCKT9qa0cEMaHoLhD
